{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lattice",
  "version": "0.1.0",
  "identifier": "com.iron-tom.lattice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lattice",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "可扩展的 Windows 桌面小组件平台",
    "longDescription": "棂 / Lattice 是一个让第三方用 HTML/CSS/JS 编写桌面小组件的平台：组件跑在沙箱里，通过权限清单申请平台能力。",
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/unraveltao/lattice/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFRDA4MUJEMkZDQzlGNkQKUldSdG44d3Z2WUhRL3BBSDIwY040T3RNKzFRc00xSFpwQ0svVUs0L3BxVlVNTjRpWEVmUEVockEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
