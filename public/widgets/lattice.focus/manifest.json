{
  "id": "lattice.focus",
  "name": "Focus",
  "version": "0.1.0",
  "description": "A pomodoro timer that keeps its place: close the lid, come back, the clock is still right",
  "author": "Lattice",
  "entry": "index.html",
  "icon": "icon.svg",
  "size": { "w": 240, "h": 156, "minW": 200, "minH": 140 },
  "layer": "top",
  "interactive": true,
  "permissions": ["storage"],
  "config": [
    {
      "key": "workMinutes",
      "type": "number",
      "label": "Focus length",
      "default": 25,
      "min": 5,
      "max": 90,
      "step": 5,
      "unit": "min"
    },
    {
      "key": "breakMinutes",
      "type": "number",
      "label": "Break length",
      "default": 5,
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "min"
    },
    {
      "key": "longBreakEvery",
      "type": "number",
      "label": "Long break after",
      "default": 4,
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "rounds",
      "help": "0 turns long breaks off."
    },
    {
      "key": "longBreakMinutes",
      "type": "number",
      "label": "Long break length",
      "default": 15,
      "min": 5,
      "max": 60,
      "step": 5,
      "unit": "min"
    },
    {
      "key": "autoStart",
      "type": "toggle",
      "label": "Start the next phase automatically",
      "default": false,
      "help": "Off means the timer stops at each boundary and waits for you."
    }
  ],
  "sdk": "^0.1"
}
