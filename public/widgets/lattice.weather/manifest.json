{
  "id": "lattice.weather",
  "name": "Weather",
  "version": "0.1.0",
  "description": "Current conditions for one city, refreshed on a timer and kept readable when the network is gone",
  "author": "Lattice",
  "entry": "index.html",
  "icon": "icon.svg",
  "size": { "w": 240, "h": 156, "minW": 200, "minH": 140 },
  "layer": "desktop",
  "interactive": false,
  "permissions": ["network", "storage"],
  "network": {
    "hosts": ["api.open-meteo.com", "geocoding-api.open-meteo.com"]
  },
  "config": [
    {
      "key": "place",
      "type": "text",
      "label": "City",
      "default": "",
      "placeholder": "Shanghai",
      "maxLength": 60,
      "help": "A city name. The first match from Open-Meteo's geocoder is used."
    },
    {
      "key": "units",
      "type": "select",
      "label": "Units",
      "default": "metric",
      "options": [
        { "value": "metric", "label": "Celsius, km/h" },
        { "value": "imperial", "label": "Fahrenheit, mph" }
      ]
    },
    {
      "key": "refreshMinutes",
      "type": "number",
      "label": "Refresh every",
      "default": 30,
      "min": 15,
      "max": 180,
      "step": 15,
      "unit": "min",
      "help": "Open-Meteo updates its current conditions every 15 minutes; asking more often returns the same numbers."
    }
  ],
  "sdk": "^0.1"
}
